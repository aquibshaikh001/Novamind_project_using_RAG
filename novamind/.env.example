# =====================================================================
# NovaMind configuration template
# Copy this file to  backend/.env  (setup.bat does this for you).
# Every value below is OPTIONAL - the defaults work out of the box.
# =====================================================================

# --- Ollama (local AI engine) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=llama3.2:3b
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_NUM_CTX=4096

# --- Retrieval ---
# Minimum cosine similarity (0..1) for a chunk to count as "relevant".
SIMILARITY_THRESHOLD=0.35
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# --- Uploads ---
MAX_UPLOAD_MB=20

# --- Voice ---
# STT = speech-to-text (needs: pip install -r requirements-voice.txt)
STT_ENABLED=false
WHISPER_MODEL=base
# TTS = text-to-speech through Edge-TTS (needs internet)
TTS_VOICE=en-IN-NeerjaNeural
